# Copiar a .env y completar. Nunca versionar el archivo .env.
ENVIRONMENT=development
# postgresql+psycopg://<usuario>:<contraseña>@<host>:5432/<base>
DATABASE_URL=
# Base de datos exclusiva para pruebas (se reconstruye en cada ejecución de pytest)
TEST_DATABASE_URL=
# Clave aleatoria de al menos 32 caracteres: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_TTL_MINUTES=480
# true cuando el sistema se sirva por HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
# true solo si la API está detrás de Nginx (X-Real-IP)
TRUST_PROXY_HEADERS=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RECOVERY_MAX_PER_IP_PER_HOUR=5
RECOVERY_MAX_PER_USERNAME_PER_DAY=3
MEASUREMENT_MAX_FUTURE_SKEW_SECONDS=300
DEVICE_STALE_MINUTES=30
MAX_READINGS_PER_BATCH=500
LOCAL_TIMEZONE=America/La_Paz
