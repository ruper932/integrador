# Variables para docker compose. Copiar a .env (no versionar) y completar.
POSTGRES_DB=atrapanieblas
POSTGRES_USER=atrapanieblas
# Contraseña larga y aleatoria
POSTGRES_PASSWORD=
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_TTL_MINUTES=480
# El sistema web se sirve por HTTPS (cookie de sesión solo por HTTPS)
COOKIE_SECURE=true
# 80: estaciones ESP32 y redirección; 443: sistema web. Certificado: sh deployment/scripts/generar-certificado.sh <IP>
HTTP_PORT=80
HTTPS_PORT=443
# Primera instalación de estaciones: datos que se precargan (la contraseña Wi-Fi nunca se muestra)
STATION_WIFI_SSID=
STATION_WIFI_PASSWORD=
STATION_API_URL=http://<IP del servidor>/api/v1/iot/measurements/batch
STATION_NTP_SERVER=<IP del servidor>
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
