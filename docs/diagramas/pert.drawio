redicción y de las variables&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;A&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;2&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;3&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;2&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0,11&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;C&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Entrenamiento del modelo con validación temporal (HU-07)&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;B&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;5&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;8&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;11&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;8&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1,00&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;D&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Evaluación de métricas y versionado del modelo&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;C&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;2&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;3&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;2&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0,11&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;E&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Integración del servicio de predicción&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;D&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;2&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;3&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;4&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;3&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0,11&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;F&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Comparación del volumen real y el estimado (HU-08)&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;E&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;3&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;4&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;5&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;4&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0,11&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;'&gt;G&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Revisión de resultados con el tutor&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;D&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Tutor&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;2&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;3&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;2&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0,11&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;H&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Revisión y retrospectiva del sprint&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;F, G&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0,00&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;spacing=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontFamily=Arial;fontColor=#1d2939;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="960" height="174" as="geometry"/></mxCell><mxCell id="v12" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;border:1px solid #475467;'&gt;&lt;tr style='height:17px;'&gt;&lt;td style='border:1px solid #475467;width:33%;'&gt;ES&lt;/td&gt;&lt;td style='border:1px solid #475467;width:34%;'&gt;&lt;b&gt;te&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #475467;width:33%;'&gt;EF&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='3' style='border:1px solid #475467;font-size:11px;'&gt;&lt;b&gt;Código&lt;/b&gt;&lt;br&gt;Actividad&lt;/td&gt;&lt;/tr&gt;&lt;tr style='height:17px;'&gt;&lt;td style='border:1px solid #475467;'&gt;LS&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;H&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;LF&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;spacing=0;strokeColor=none;fillColor=#ffffff;align=center;fontSize=10;fontFamily=Arial;fontColor=#1d2939;" vertex="1" parent="1"><mxGeometry x="1040" y="416" width="176" height="96" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Lectura del nodo&lt;/b&gt;&lt;br&gt;ES / EF: inicio y fin más tempranos&lt;br&gt;LS / LF: inicio y fin más tardíos&lt;br&gt;H: holgura (LS − ES)&lt;br&gt;te = (a + 4m + b) / 6 · σ² = ((b − a) / 6)²&lt;br&gt;&lt;span style='color:#b42318;'&gt;&lt;b&gt;Rojo: ruta crítica (H = 0)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Duraciones en días hábiles" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#1d2939;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1232" y="412" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pert7" name="PERT Sprint 7 - Evaluación"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1908" pageHeight="649" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="nA" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;border:2px solid #b42318;'&gt;&lt;tr style='height:17px;'&gt;&lt;td style='border:1px solid #b42318;width:33%;'&gt;0&lt;/td&gt;&lt;td style='border:1px solid #b42318;width:34%;'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b42318;width:33%;'&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='3' style='border:1px solid #b42318;font-size:11px;'&gt;&lt;b&gt;A&lt;/b&gt;&lt;br&gt;Planificación del sprint&lt;/td&gt;&lt;/tr&gt;&lt;tr style='height:17px;'&gt;&lt;td style='border:1px solid #b42318;'&gt;0&lt;/td&gt;&lt;td style='border:1px solid #b42318;'&gt;0&lt;/td&gt;&lt;td style='border:1px solid #b42318;'&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;spacing=0;rounded=0;strokeColor=none;align=center;verticalAlign=middle;fontSize=10;fontFamily=Arial;fontColor=#1d2939;fillColor=#fdecea;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="176" height="96" as="geometry"/></mxCell><mxCell id="nB" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;border:2px solid #b42318;'&gt;&lt;tr style='height:17px;'&gt;&lt;td style='