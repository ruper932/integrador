px solid #475467;background:#eef2f6;'&gt;Cód.&lt;/th&gt;&lt;th style='border:1px solid #475467;background:#eef2f6;'&gt;Actividad&lt;/th&gt;&lt;th style='border:1px solid #475467;background:#eef2f6;'&gt;Pred.&lt;/th&gt;&lt;th style='border:1px solid #475467;background:#eef2f6;'&gt;Responsable&lt;/th&gt;&lt;th style='border:1px solid #475467;background:#eef2f6;'&gt;te&lt;/th&gt;&lt;th style='border:1px solid #475467;background:#eef2f6;'&gt;σ²&lt;/th&gt;&lt;th style='border:1px solid #475467;background:#eef2f6;'&gt;ES&lt;/th&gt;&lt;th style='border:1px solid #475467;background:#eef2f6;'&gt;EF&lt;/th&gt;&lt;th style='border:1px solid #475467;background:#eef2f6;'&gt;H&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;S1&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Sprint 1: Análisis&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;14&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0,78&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;14&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;S2&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Sprint 2: Diseño&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;S1&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;18&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0,56&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;14&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;32&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;'&gt;AC&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Adquisición de componentes IoT (a = 10, m = 15, b = 20)&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;S2&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Proveedor&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;15&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;2,78&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;32&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;47&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;18&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;S3&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Sprint 3: Desarrollo web&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;S2&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;33&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1,33&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;32&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;65&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;S4&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Sprint 4: Implementación IoT&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;S3, AC&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;27&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1,44&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;65&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;92&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;S5&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Sprint 5: Preparación de datos&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;S4&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;42&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;11,56&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;92&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;134&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;S6&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Sprint 6: Machine learning&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;S5&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;21&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1,44&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;134&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;155&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #475467;color:#b42318;font-weight:bold;'&gt;S7&lt;/td&gt;&lt;td style='border:1px solid #475467;text-align:left;'&gt;Sprint 7: Evaluación&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;S6&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;Estudiante&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;21&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;1,33&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;155&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;176&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;spacing=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontFamily=Arial;fontColor=#1d2939;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="960" height="174" as="geometry"/></mxCell><mxCell id="v12" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;border:1px solid #475467;'&gt;&lt;tr style