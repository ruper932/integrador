5467;'&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;spacing=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontFamily=Arial;fontColor=#1d2939;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="960" height="193" as="geometry"/></mxCell><mxCell id="v14" value="&lt;table style='width:100%;height:100%;border-collapse:collapse;border:1px solid #475467;'&gt;&lt;tr style='height:17px;'&gt;&lt;td style='border:1px solid #475467;width:33%;'&gt;ES&lt;/td&gt;&lt;td style='border:1px solid #475467;width:34%;'&gt;&lt;b&gt;te&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #475467;width:33%;'&gt;EF&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='3' style='border:1px solid #475467;font-size:11px;'&gt;&lt;b&gt;Código&lt;/b&gt;&lt;br&gt;Actividad&lt;/td&gt;&lt;/tr&gt;&lt;tr style='height:17px;'&gt;&lt;td style='border:1px solid #475467;'&gt;LS&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;H&lt;/td&gt;&lt;td style='border:1px solid #475467;'&gt;LF&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;spacing=0;strokeColor=none;fillColor=#ffffff;align=center;fontSize=10;fontFamily=Arial;fontColor=#1d2939;" vertex="1" parent="1"><mxGeometry x="1040" y="556" width="176" height="96" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Lectura del nodo&lt;/b&gt;&lt;br&gt;ES / EF: inicio y fin más tempranos&lt;br&gt;LS / LF: inicio y fin más tardíos&lt;br&gt;H: holgura (LS − ES)&lt;br&gt;te = (a + 4m + b) / 6 · σ² = ((b − a) / 6)²&lt;br&gt;&lt;span style='color:#b42318;'&gt;&lt;b&gt;Rojo: ruta crítica (H = 0)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Duraciones en días hábiles" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#1d2939;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1232" y="552" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pert3" name="PERT Spri