          <mxGeometry x="365" y="510" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Rechazar: «periodo_anterior_abierto»" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8c5708;fontFamily=Helvetica;fontSize=12;fontColor=#182c37;" vertex="1" parent="1">
          <mxGeometry x="720" y="525" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="¿Conteo de todos&lt;br&gt;los repuestos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#182c37;fontFamily=Helvetica;fontSize=12;fontColor=#182c37;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="365" y="625" width="170" height="80" as="geometry" />
