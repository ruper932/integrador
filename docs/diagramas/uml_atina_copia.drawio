  <diagram name="M6 Cierre de periodo — Actividad" id="p15">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="&lt;b&gt;Módulo 6 · Cierre de un periodo de inventario — diagrama de actividad&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#596e7a&quot;&gt;Conteo físico, ajustes por sobrante o faltante, saldos congelados y valorización por costo promedio ponderado&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontFamily=Helvetica;fontSize=12;fontColor=#182c37;fontSize=20;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="" style="ellipse;html=1;fillColor=#182c37;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="437" y="90" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Abrir periodo (sin superponer fechas)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e4f3f2;strokeColor=#087e83;fontFamily=Helvetica;fontSize=12;fontColor=#182c37;" vertex="1" parent="1">
          <mxGeometry x="340" y="140" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Registrar entradas (con costo en Bs) y salidas durante el periodo" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e4f3f2;strokeColor=#087e83;fontFamily=Helvetica;fontSize=12;fontColor=#182c37;" vertex="1" parent="1">
          <mxGeometry x="320" y="220" width="260" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Al final del periodo: conteo físico de cada repuesto" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e4f3f2;strokeColor=#087e83;fontFamily=Helvetica;fontSize=12;fontColor=#182c37;" vertex="1" parent="1">
          <mxGeometry x="320" y="310" width="260" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="¿Periodo&lt;br&gt;terminado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#182c37;fontFamily=Helvetica;fontSize=12;fontColor=#182c37;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="375" y="400" width="150" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="Rechazar: «periodo_en_curso»" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#fff4df;strokeColor=#8c5708;fontFamily=Helvetica;fontSize=12;fontColor=#182c37;" vertex="1" parent="1">
          <mxGeometry x="720" y="410" width="220" height="50" as="geometry" />
        </mxCell>
