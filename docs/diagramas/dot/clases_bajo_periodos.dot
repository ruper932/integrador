digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "inventory_periods" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>InventoryPeriod</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ name: str<br/>+ start_date: date<br/>+ end_date: date<br/>+ status: str<br/>+ notes: str [0..1]<br/>+ created_by_id: int {FK}<br/>+ created_at: datetime<br/>+ closed_by_id: int [0..1] {FK}<br/>+ closed_at: datetime [0..1]</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "inventory_counts" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>InventoryCount</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ period_id: int {FK}<br/>+ item_id: int {FK}<br/>+ counted_quantity: decimal<br/>+ theoretical_quantity: decimal [0..1]<br/>+ difference: decimal [0..1]<br/>+ notes: str [0..1]<br/>+ counted_by_id: int {FK}<br/>+ counted_at: datetime</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "inventory_period_balances" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>InventoryPeriodBalance</b></td></tr><tr><td align="left" balign="left">+ period_id: int {PK}<br/>+ item_id: int {PK}<br/>+ opening_quantity: decimal<br/>+ entries_quantity: decimal<br/>+ exits_quantity: decimal<br/>+ maintenance_exits_quantity: decimal<br/>+ adjustments_quantity: decimal<br/>+ closing_quantity: decimal<br/>+ opening_value: decimal [0..1]<br/>+ entries_value: decimal [0..1]<br/>+ average_unit_cost: decimal [0..1]<br/>+ closing_value: decimal [0..1]</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "inventory_periods" -> "users" [arrowhead=none, taillabel="*", headlabel="1", label="created_by", labelfontsize=11];
  "inventory_periods" -> "users" [arrowhead=none, taillabel="*", headlabel="0..1", label="closed_by", labelfontsize=11];
  "inventory_counts" -> "inventory_periods" [arrowhead=none, taillabel="*", headlabel="1", label="period", labelfontsize=11];
  "inventory_counts" -> "inventory_items" [arrowhead=none, taillabel="*", headlabel="1", label="item", labelfontsize=11];
  "inventory_counts" -> "users" [arrowhead=none, taillabel="*", headlabel="1", label="counted_by", labelfontsize=11];
  "inventory_period_balances" -> "inventory_periods" [arrowhead=none, taillabel="0..1", headlabel="1", label="period", labelfontsize=11];
  "inventory_period_balances" -> "inventory_items" [arrowhead=none, taillabel="0..1", headlabel="1", label="item", labelfontsize=11];
  "inventory_items" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>InventoryItem</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>User</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
}