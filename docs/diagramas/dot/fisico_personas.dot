digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "user_profiles" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> user_profiles </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>user_id</b></td><td port="user_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">first_names</td><td port="first_names" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(100) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">paternal_surname</td><td port="paternal_surname" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(60)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">maternal_surname</td><td port="maternal_surname" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(60)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">ci_number</td><td port="ci_number" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(12)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">ci_complement</td><td port="ci_complement" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(4)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">ci_issued_in</td><td port="ci_issued_in" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(2)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">institutional_email</td><td port="institutional_email" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(120)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">personal_email</td><td port="personal_email" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(120)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">mobile_phone</td><td port="mobile_phone" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(8)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">birth_date</td><td port="birth_date" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">date</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">address</td><td port="address" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">text</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">position_id</td><td port="position_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">updated_at</td><td port="updated_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "user_degrees" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> user_degrees </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">user_id</td><td port="user_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">academic_level_id</td><td port="academic_level_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">title</td><td port="title" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(200) NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">institution_id</td><td port="institution_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">graduation_year</td><td port="graduation_year" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">smallint</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">updated_at</td><td port="updated_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "positions" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> positions </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">code</td><td port="code" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(40) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">name</td><td port="name" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(120) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">is_active</td><td port="is_active" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">boolean NN</font></td></tr></table>>];
  "academic_levels" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> academic_levels </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">code</td><td port="code" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(40) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">name</td><td port="name" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(120) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">sort_order</td><td port="sort_order" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">smallint NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">min_graduation_age</td><td port="min_graduation_age" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">smallint NN</font></td></tr></table>>];
  "institutions" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> institutions </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">name</td><td port="name" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(200) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">acronym</td><td port="acronym" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(30)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">institution_type</td><td port="institution_type" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(40) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">city</td><td port="city" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(80)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">is_active</td><td port="is_active" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">boolean NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">updated_at</td><td port="updated_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> users </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "user_profiles":"user_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
  "user_profiles":"position_id":e -> "positions":w [arrowhead=none, arrowtail=crow, dir=both];
  "user_degrees":"user_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
