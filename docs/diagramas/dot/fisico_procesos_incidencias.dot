digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "incident_reports" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> incident_reports </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">reported_by_id</td><td port="reported_by_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">source</td><td port="source" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(10) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">auto_cause</td><td port="auto_cause" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(30)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">title</td><td port="title" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(120) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">description</td><td port="description" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">text NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">priority</td><td port="priority" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(10) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">location_reference</td><td port="location_reference" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(200)</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">device_id</td><td port="device_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">sensor_id</td><td port="sensor_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">updated_at</td><td port="updated_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "notifications" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> notifications </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">user_id</td><td port="user_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">title</td><td port="title" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(150) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">message</td><td port="message" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(500) NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">incident_report_id</td><td port="incident_report_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">relocation_id</td><td port="relocation_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">read_at</td><td port="read_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr></table>>];
  "devices" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> devices </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "fog_collector_relocations" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> fog_collector_relocations </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "sensors" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> sensors </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> users </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "incident_reports":"reported_by_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
  "incident_reports":"device_id":e -> "devices":w [arrowhead=none, arrowtail=crow, dir=both];
  "incident_reports":"sensor_id":e -> "sensors":w [arrowhead=none, arrowtail=crow, dir=both];
  "notifications":"user_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
  "notifications":"incident_report_id":e -> "incident_reports":w [arrowhead=none, arrowtail=crow, dir=both];
  "notifications":"relocation_id":e -> "fog_collector_relocations":w [arrowhead=none, arrowtail=crow, dir=both];
}