digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "devices" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>Device</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ code: str<br/>+ name: str<br/>+ description: str [0..1]<br/>+ firmware_version: str [0..1]<br/>+ status: str<br/>+ fog_collector_id: int [0..1] {FK}<br/>+ last_seen_at: datetime [0..1]<br/>+ target_firmware_id: int [0..1] {FK}<br/>+ sample_interval_s: int<br/>+ created_at: datetime<br/>+ updated_at: datetime</td></tr><tr><td align="left" balign="left">+ target_firmware_version(): Union</td></tr></table>>];
  "device_credentials" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>DeviceCredential</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ device_id: int {FK}<br/>+ key_hash: str<br/>+ key_prefix: str<br/>+ created_at: datetime<br/>+ revoked_at: datetime [0..1]</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "device_locations" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>DeviceLocation</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ device_id: int {FK}<br/>+ location_id: int {FK}<br/>+ started_at: datetime<br/>+ ended_at: datetime [0..1]</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "firmware_releases" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>FirmwareRelease</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ version: str<br/>+ size_bytes: int<br/>+ sha256: str<br/>+ md5: str<br/>+ content: bytes<br/>+ notes: str [0..1]<br/>+ uploaded_by_id: int {FK}<br/>+ created_at: datetime</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "devices" -> "fog_collectors" [arrowhead=none, taillabel="*", headlabel="0..1", label="", labelfontsize=11];
  "devices" -> "firmware_releases" [arrowhead=none, taillabel="*", headlabel="0..1", label="target_firmware", labelfontsize=11];
  "device_credentials" -> "devices" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "device_locations" -> "devices" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "device_locations" -> "locations" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "firmware_releases" -> "users" [arrowhead=none, taillabel="*", headlabel="1", label="uploaded_by", labelfontsize=11];
  "fog_collectors" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>FogCollector</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "locations" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>Location</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>User</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
}