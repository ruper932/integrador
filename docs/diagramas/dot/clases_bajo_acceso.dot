digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "users" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>User</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ username: str<br/>+ password_hash: str<br/>+ is_active: bool<br/>+ must_change_password: bool<br/>+ failed_login_attempts: int<br/>+ locked_until: datetime [0..1]<br/>+ last_login_at: datetime [0..1]<br/>+ password_changed_at: datetime [0..1]<br/>+ created_at: datetime<br/>+ updated_at: datetime</td></tr><tr><td align="left" balign="left">+ full_name(): str<br/>+ profile_complete(): bool<br/>+ permission_codes(): set</td></tr></table>>];
  "roles" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>Role</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ name: str<br/>+ description: str<br/>+ is_system: bool<br/>+ created_at: datetime<br/>+ updated_at: datetime</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "permissions" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>Permission</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ code: str<br/>+ description: str</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "user_sessions" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>UserSession</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ user_id: int {FK}<br/>+ token_hash: str<br/>+ created_at: datetime<br/>+ expires_at: datetime<br/>+ revoked_at: datetime [0..1]<br/>+ ip_address: inet [0..1]<br/>+ user_agent: str [0..1]</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "audit_logs" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>AuditLog</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ user_id: int [0..1] {FK}<br/>+ action: str<br/>+ entity_type: str [0..1]<br/>+ entity_id: str [0..1]<br/>+ details: json [0..1]<br/>+ ip_address: inet [0..1]<br/>+ created_at: datetime</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "account_recovery_requests" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>AccountRecoveryRequest</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ username_requested: str<br/>+ user_id: int [0..1] {FK}<br/>+ status: str<br/>+ message: str [0..1]<br/>+ requester_ip: inet [0..1]<br/>+ created_at: datetime<br/>+ resolved_at: datetime [0..1]<br/>+ resolved_by_id: int [0..1] {FK}<br/>+ resolution_note: str [0..1]</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "users" -> "roles" [arrowhead=none, taillabel="*", headlabel="*", label="", labelfontsize=11];
  "roles" -> "permissions" [arrowhead=none, taillabel="*", headlabel="*", label="", labelfontsize=11];
  "user_sessions" -> "users" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "audit_logs" -> "users" [arrowhead=none, taillabel="*", headlabel="0..1", label="", labelfontsize=11];
  "account_recovery_requests" -> "users" [arrowhead=none, taillabel="*", headlabel="0..1", label="", labelfontsize=11];
  "account_recovery_requests" -> "users" [arrowhead=none, taillabel="*", headlabel="0..1", label="resolved_by", labelfontsize=11];
}