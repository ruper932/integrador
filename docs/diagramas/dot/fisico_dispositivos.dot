digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "devices" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> devices </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">code</td><td port="code" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(40) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">name</td><td port="name" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(120) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">description</td><td port="description" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">text</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">firmware_version</td><td port="firmware_version" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(40)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">status</td><td port="status" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(16) NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">fog_collector_id</td><td port="fog_collector_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">last_seen_at</td><td port="last_seen_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">target_firmware_id</td><td port="target_firmware_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">sample_interval_s</td><td port="sample_interval_s" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">updated_at</td><td port="updated_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "device_credentials" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> device_credentials </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">device_id</td><td port="device_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">key_hash</td><td port="key_hash" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(64) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">key_prefix</td><td port="key_prefix" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(12) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">revoked_at</td><td port="revoked_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr></table>>];
  "device_locations" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> device_locations </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">device_id</td><td port="device_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">location_id</td><td port="location_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">started_at</td><td port="started_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">ended_at</td><td port="ended_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr></table>>];
  "firmware_releases" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> firmware_releases </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">version</td><td port="version" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(32) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">size_bytes</td><td port="size_bytes" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">sha256</td><td port="sha256" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(64) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">md5</td><td port="md5" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(32) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">content</td><td port="content" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">bytea NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">notes</td><td port="notes" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">text</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">uploaded_by_id</td><td port="uploaded_by_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "fog_collectors" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> fog_collectors </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "locations" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> locations </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> users </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "devices":"fog_collector_id":e -> "fog_collectors":w [arrowhead=none, arrowtail=crow, dir=both];
  "devices":"target_firmware_id":e -> "firmware_releases":w [arrowhead=none, arrowtail=crow, dir=both];
  "device_credentials":"device_id":e -> "devices":w [arrowhead=none, arrowtail=crow, dir=both];
  "device_locations":"device_id":e -> "devices":w [arrowhead=none, arrowtail=crow, dir=both];
  "device_locations":"location_id":e -> "locations":w [arrowhead=none, arrowtail=crow, dir=both];
  "firmware_releases":"uploaded_by_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
}