digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "inventory_categories" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> inventory_categories </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">name</td><td port="name" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(80) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">description</td><td port="description" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">text</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">is_active</td><td port="is_active" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">boolean NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">updated_at</td><td port="updated_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "inventory_items" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> inventory_items </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">code</td><td port="code" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(40) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">name</td><td port="name" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(150) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">description</td><td port="description" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">text</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">category_id</td><td port="category_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">unit</td><td port="unit" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(20) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">current_stock</td><td port="current_stock" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">min_stock</td><td port="min_stock" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">condition</td><td port="condition" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(20) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">storage_location</td><td port="storage_location" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(120)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">is_active</td><td port="is_active" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">boolean NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">updated_at</td><td port="updated_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "inventory_item_compatibility" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> inventory_item_compatibility </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">item_id</td><td port="item_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">device_id</td><td port="device_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">sensor_id</td><td port="sensor_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr></table>>];
  "inventory_movement_types" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> inventory_movement_types </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">code</td><td port="code" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(40) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">name</td><td port="name" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(80) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">direction</td><td port="direction" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">smallint NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">manual_allowed</td><td port="manual_allowed" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">boolean NN</font></td></tr></table>>];
  "inventory_movements" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> inventory_movements </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">item_id</td><td port="item_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">movement_type_id</td><td port="movement_type_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">quantity</td><td port="quantity" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">stock_before</td><td port="stock_before" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">stock_after</td><td port="stock_after" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">reason</td><td port="reason" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(255) NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">user_id</td><td port="user_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">maintenance_record_id</td><td port="maintenance_record_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">unit_cost</td><td port="unit_cost" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 4)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">occurred_at</td><td port="occurred_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "devices" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> devices </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "maintenance_records" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> maintenance_records </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "sensors" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> sensors </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> users </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "inventory_items":"category_id":e -> "inventory_categories":w [arrowhead=none, arrowtail=crow, dir=both];
  "inventory_item_compatibility":"item_id":e -> "inventory_items":w [arrowhead=none, arrowtail=crow, dir=both];
  "inventory_item_compatibility":"device_id":e -> "devices":w [arrowhead=none, arrowtail=crow, dir=both];
  "inventory_item_compatibility":"sensor_id":e -> "sensors":w [arrowhead=none, arrowtail=crow, dir=both];
  "inventory_movements":"item_id":e -> "inventory_items":w [arrowhead=none, arrowtail=crow, dir=both];
  "inventory_movements":"movement_type_id":e -> "inventory_movement_types":w [arrowhead=none, arrowtail=crow, dir=both];
  "inventory_movements":"user_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
  "inventory_movements":"maintenance_record_id":e -> "maintenance_records":w [arrowhead=none, arrowtail=crow, dir=both];
}