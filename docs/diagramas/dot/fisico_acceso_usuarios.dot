digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "users" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> users </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">username</td><td port="username" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(64) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">password_hash</td><td port="password_hash" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(255) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">is_active</td><td port="is_active" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">boolean NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">must_change_password</td><td port="must_change_password" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">boolean NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">failed_login_attempts</td><td port="failed_login_attempts" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">locked_until</td><td port="locked_until" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">last_login_at</td><td port="last_login_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">password_changed_at</td><td port="password_changed_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">updated_at</td><td port="updated_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "user_roles" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> user_roles </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>user_id</b></td><td port="user_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>role_id</b></td><td port="role_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr></table>>];
  "roles" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> roles </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">name</td><td port="name" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(64) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">description</td><td port="description" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(255) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">is_system</td><td port="is_system" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">boolean NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">updated_at</td><td port="updated_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "role_permissions" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> role_permissions </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>role_id</b></td><td port="role_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>permission_id</b></td><td port="permission_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr></table>>];
  "permissions" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> permissions </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">code</td><td port="code" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(64) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">description</td><td port="description" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(255) NN</font></td></tr></table>>];
  "user_roles":"user_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
  "user_roles":"role_id":e -> "roles":w [arrowhead=none, arrowtail=crow, dir=both];
  "role_permissions":"role_id":e -> "roles":w [arrowhead=none, arrowtail=crow, dir=both];
  "role_permissions":"permission_id":e -> "permissions":w [arrowhead=none, arrowtail=crow, dir=both];
}