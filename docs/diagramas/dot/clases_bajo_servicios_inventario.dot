digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.25, ranksep=0.4];
  "InventoryService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td bgcolor="#E7D7C7"><font point-size="9">«servicio»</font><br/><b>InventoryService</b></td></tr><tr><td align="left" balign="left">+ list_categories(include_inactive)<br/>+ create_category(name, description)<br/>+ list_movement_types()<br/>+ search_items(filters)<br/>+ get_item(item_id)<br/>+ create_item(data, initial_stock, device_ids, …)<br/>+ update_item(item_id, data, device_ids, …)<br/>+ deactivate_item(item_id)<br/>+ low_stock()<br/>+ stock_report(include_inactive, category_id, condition, …)<br/>+ register_movement(item_id, movement_type_code, quantity, …)<br/>+ apply_movement(item_id, movement_type_code, quantity, …)<br/>+ search_movements(offset, limit, item_id, …)</td></tr></table>>];
  "InventoryPeriodService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td bgcolor="#E7D7C7"><font point-size="9">«servicio»</font><br/><b>InventoryPeriodService</b></td></tr><tr><td align="left" balign="left">+ boundaries(period)<br/>+ list()<br/>+ get(period_id)<br/>+ create(name, start_date, end_date, …)<br/>+ register_counts(period_id, entries)<br/>+ summary(period_id)<br/>+ close(period_id)</td></tr></table>>];
  "MaintenanceService" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td bgcolor="#E7D7C7"><font point-size="9">«servicio»</font><br/><b>MaintenanceService</b></td></tr><tr><td align="left" balign="left">+ search(filters)<br/>+ get(record_id)<br/>+ validate_target(device_id, sensor_id)<br/>+ apply_final_status(record, device_id, sensor_id, …)<br/>+ consume_parts(record, parts)<br/>+ register(device_id, sensor_id, performed_at, …)</td></tr></table>>];
  { rank=same; "InventoryService"; "InventoryPeriodService"; "MaintenanceService"; }
}