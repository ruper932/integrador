  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "user_sessions" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> user_sessions </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">user_id</td><td port="user_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">token_hash</td><td port="token_hash" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(64) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">expires_at</td><td port="expires_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">revoked_at</td><td port="revoked_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">ip_address</td><td port="ip_address" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">inet</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">user_agent</td><td port="user_agent" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(255)</font></td></tr></table>>];
  "audit_logs" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> audit_logs </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">user_id</td><td port="user_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">action</td><td port="action" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(80) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">entity_type</td><td port="entity_type" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(80)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">entity_id</td><td port="entity_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(64)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">details</td><td port="details" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">jsonb</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">ip_address</td><td port="ip_address" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">inet</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "account_recovery_requests" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> account_recovery_requests </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">username_requested</td><td port="username_requested" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(64) NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">user_id</td><td port="user_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">status</td><td port="status" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(16) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">message</td><td port="message" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">text</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">requester_ip</td><td port="requester_ip" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">inet</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">resolved_at</td><td port="resolved_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">resolved_by_id</td><td port="resolved_by_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">resolution_note</td><td port="resolution_note" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">text</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> users </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">username</td><td port="username" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(64) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">password_hash</td><td port="password_hash" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(255) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">is_active</td><td port="is_active" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">boolean NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">must_change_password</td><td port="must_change_password" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">boolean NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">failed_login_attempts</td><td port="failed_login_attempts" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">locked_until</td><td port="locked_until" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">last_login_at</td><td port="last_login_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">password_changed_at</td><td port="password_changed_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">updated_at</td><td port="updated_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "user_sessions":"user_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
  "audit_logs":"user_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
