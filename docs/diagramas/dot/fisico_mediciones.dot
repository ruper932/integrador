_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">updated_at</td><td port="updated_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "sensor_types" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> sensor_types </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">code</td><td port="code" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(40) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">name</td><td port="name" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(120) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">unit</td><td port="unit" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(16) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">min_value</td><td port="min_value" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">float NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">max_value</td><td port="max_value" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">float NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">aggregation</td><td port="aggregation" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(16) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">description</td><td port="description" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">text</font></td></tr></table>>];
  "measurement_batches" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> measurement_batches </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">device_id</td><td port="device_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">batch_uid</td><td port="batch_uid" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">uuid NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">sent_at</td><td port="sent_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">received_at</td><td port="received_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">readings_count</td><td port="readings_count" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">accepted_count</td><td port="accepted_count" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">invalid_count</td><td port="invalid_count" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></