digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "maintenance_records" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> maintenance_records </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">status</td><td port="status" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(15) NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">incident_report_id</td><td port="incident_report_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer UQ</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">device_id</td><td port="device_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">sensor_id</td><td port="sensor_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">performed_at</td><td port="performed_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">user_id</td><td port="user_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">maintenance_type</td><td port="maintenance_type" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(20)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">description</td><td port="description" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">text</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">final_status</td><td port="final_status" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(30)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">accepted_at</td><td port="accepted_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">started_at</td><td port="started_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">finished_at</td><td port="finished_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "maintenance_items" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> maintenance_items </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">maintenance_record_id</td><td port="maintenance_record_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">item_id</td><td port="item_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">quantity</td><td port="quantity" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">movement_id</td><td port="movement_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN UQ</font></td></tr></table>>];
  "devices" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> devices </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "incident_reports" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> incident_reports </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "inventory_items" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> inventory_items </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "inventory_movements" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> inventory_movements </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "sensors" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> sensors </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> users </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "maintenance_records":"incident_report_id":e -> "incident_reports":w [arrowhead=none, arrowtail=crow, dir=both];
  "maintenance_records":"device_id":e -> "devices":w [arrowhead=none, arrowtail=crow, dir=both];
  "maintenance_records":"sensor_id":e -> "sensors":w [arrowhead=none, arrowtail=crow, dir=both];
  "maintenance_records":"user_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
  "maintenance_items":"maintenance_record_id":e -> "maintenance_records":w [arrowhead=none, arrowtail=crow, dir=both];
  "maintenance_items":"item_id":e -> "inventory_items":w [arrowhead=none, arrowtail=crow, dir=both];
  "maintenance_items":"movement_id":e -> "inventory_movements":w [arrowhead=none, arrowtail=crow, dir=both];
}