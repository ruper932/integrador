  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "inventory_periods" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> inventory_periods </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">name</td><td port="name" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(80) NN UQ</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">start_date</td><td port="start_date" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">date NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">end_date</td><td port="end_date" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">date NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">status</td><td port="status" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(10) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">notes</td><td port="notes" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">text</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">created_by_id</td><td port="created_by_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">created_at</td><td port="created_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">closed_by_id</td><td port="closed_by_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">closed_at</td><td port="closed_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz</font></td></tr></table>>];
  "inventory_counts" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> inventory_counts </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>id</b></td><td port="id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">period_id</td><td port="period_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">item_id</td><td port="item_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">counted_quantity</td><td port="counted_quantity" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">theoretical_quantity</td><td port="theoretical_quantity" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">difference</td><td port="difference" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">notes</td><td port="notes" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">varchar(255)</font></td></tr><tr><td align="left"><font color="#55675C">FK</font></td><td align="left">counted_by_id</td><td port="counted_by_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">counted_at</td><td port="counted_at" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">timestamptz NN</font></td></tr></table>>];
  "inventory_period_balances" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#2B4D3B" align="left"><font color="white"><b> inventory_period_balances </b></font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>period_id</b></td><td port="period_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C">PK</font></td><td align="left"><b>item_id</b></td><td port="item_id" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">integer</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">opening_quantity</td><td port="opening_quantity" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">entries_quantity</td><td port="entries_quantity" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">exits_quantity</td><td port="exits_quantity" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">maintenance_exits_quantity</td><td port="maintenance_exits_quantity" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">adjustments_quantity</td><td port="adjustments_quantity" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">closing_quantity</td><td port="closing_quantity" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 3) NN</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">opening_value</td><td port="opening_value" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(14, 2)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">entries_value</td><td port="entries_value" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(14, 2)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">average_unit_cost</td><td port="average_unit_cost" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(12, 4)</font></td></tr><tr><td align="left"><font color="#55675C"> </font></td><td align="left">closing_value</td><td port="closing_value" align="left"><font face="DejaVu Sans Mono" point-size="11" color="#55675C">numeric(14, 2)</font></td></tr></table>>];
  "inventory_items" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> inventory_items </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2B4D3B" bgcolor="white"><tr><td colspan="3" bgcolor="#E7D7C7" align="left"><font color="#2B4D3B"><b> users </b></font></td></tr><tr><td colspan="3" port="id" align="left"><font point-size="9" color="#55675C">(tabla de otro módulo)</font></td></tr></table>>];
  "inventory_periods":"created_by_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
  "inventory_periods":"closed_by_id":e -> "users":w [arrowhead=none, arrowtail=crow, dir=both];
