digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "incident_reports" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>IncidentReport</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ reported_by_id: int [0..1] {FK}<br/>+ source: str<br/>+ auto_cause: str [0..1]<br/>+ title: str<br/>+ description: str<br/>+ priority: str<br/>+ location_reference: str [0..1]<br/>+ device_id: int [0..1] {FK}<br/>+ sensor_id: int [0..1] {FK}<br/>+ created_at: datetime<br/>+ updated_at: datetime</td></tr><tr><td align="left" balign="left">+ status(): str</td></tr></table>>];
  "fog_collector_relocations" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>FogCollectorRelocation</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ fog_collector_id: int {FK}<br/>+ requested_by_id: int {FK}<br/>+ reason: str<br/>+ description: str<br/>+ origin_location_id: int [0..1] {FK}<br/>+ proposed_location_id: int [0..1] {FK}<br/>+ proposed_place: str [0..1]<br/>+ status: str<br/>+ assigned_to_id: int [0..1] {FK}<br/>+ accepted_at: datetime [0..1]<br/>+ started_at: datetime [0..1]<br/>+ finished_at: datetime [0..1]<br/>+ destination_location_id: int [0..1] {FK}<br/>+ previous_orientation: str [0..1]<br/>+ new_orientation: str [0..1]<br/>+ work_notes: str [0..1]<br/>+ rejection_reason: str [0..1]<br/>+ created_at: datetime<br/>+ updated_at: datetime</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "notifications" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>Notification</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ user_id: int {FK}<br/>+ title: str<br/>+ message: str<br/>+ incident_report_id: int [0..1] {FK}<br/>+ relocation_id: int [0..1] {FK}<br/>+ created_at: datetime<br/>+ read_at: datetime [0..1]</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "incident_reports" -> "users" [arrowhead=none, taillabel="*", headlabel="0..1", label="reported_by", labelfontsize=11];
  "incident_reports" -> "devices" [arrowhead=none, taillabel="*", headlabel="0..1", label="", labelfontsize=11];
  "incident_reports" -> "sensors" [arrowhead=none, taillabel="*", headlabel="0..1", label="", labelfontsize=11];
  "fog_collector_relocations" -> "fog_collectors" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "fog_collector_relocations" -> "users" [arrowhead=none, taillabel="*", headlabel="1", label="requested_by", labelfontsize=11];
  "fog_collector_relocations" -> "locations" [arrowhead=none, taillabel="*", headlabel="0..1", label="origin_location", labelfontsize=11];
  "fog_collector_relocations" -> "locations" [arrowhead=none, taillabel="*", headlabel="0..1", label="proposed_location", labelfontsize=11];
  "fog_collector_relocations" -> "users" [arrowhead=none, taillabel="*", headlabel="0..1", label="assigned_to", labelfontsize=11];
  "fog_collector_relocations" -> "locations" [arrowhead=none, taillabel="*", headlabel="0..1", label="destination_location", labelfontsize=11];
  "notifications" -> "users" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "notifications" -> "incident_reports" [arrowhead=none, taillabel="*", headlabel="0..1", label="", labelfontsize=11];
  "notifications" -> "fog_collector_relocations" [arrowhead=none, taillabel="*", headlabel="0..1", label="relocation", labelfontsize=11];
  "devices" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>Device</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "fog_collectors" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>FogCollector</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "locations" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>Location</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "sensors" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>Sensor</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>User</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
}