digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "sensors" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>Sensor</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ device_id: int {FK}<br/>+ sensor_type_id: int {FK}<br/>+ code: str<br/>+ model: str [0..1]<br/>+ status: str<br/>+ fog_collector_id: int [0..1] {FK}<br/>+ tank_id: int [0..1] {FK}<br/>+ created_at: datetime<br/>+ updated_at: datetime</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "sensor_types" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>SensorType</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ code: str<br/>+ name: str<br/>+ unit: str<br/>+ min_value: float<br/>+ max_value: float<br/>+ aggregation: str<br/>+ description: str [0..1]</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "measurement_batches" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>MeasurementBatch</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ device_id: int {FK}<br/>+ batch_uid: uuid<br/>+ sent_at: datetime [0..1]<br/>+ received_at: datetime<br/>+ readings_count: int<br/>+ accepted_count: int<br/>+ invalid_count: int<br/>+ rejected_count: int<br/>+ duplicate_count: int</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "sensor_readings" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>SensorReading</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ message_uid: uuid<br/>+ batch_id: int {FK}<br/>+ device_id: int {FK}<br/>+ sensor_id: int {FK}<br/>+ sensor_type_id: int {FK}<br/>+ measured_at: datetime<br/>+ received_at: datetime<br/>+ value: float [0..1]<br/>+ unit: str<br/>+ quality: str<br/>+ quality_detail: str [0..1]</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "sensor_calibrations" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>SensorCalibration</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ sensor_id: int {FK}<br/>+ calibrated_at: datetime<br/>+ offset_value: decimal<br/>+ scale_factor: decimal<br/>+ notes: str [0..1]<br/>+ user_id: int [0..1] {FK}<br/>+ created_at: datetime</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "sensors" -> "devices" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "sensors" -> "sensor_types" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "sensors" -> "fog_collectors" [arrowhead=none, taillabel="*", headlabel="0..1", label="", labelfontsize=11];
  "sensors" -> "tanks" [arrowhead=none, taillabel="*", headlabel="0..1", label="", labelfontsize=11];
  "measurement_batches" -> "devices" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "sensor_readings" -> "measurement_batches" [arrowhead=none, taillabel="*", headlabel="1", label="batch", labelfontsize=11];
  "sensor_readings" -> "devices" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "sensor_readings" -> "sensors" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "sensor_readings" -> "sensor_types" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "sensor_calibrations" -> "sensors" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "sensor_calibrations" -> "users" [arrowhead=none, taillabel="*", headlabel="0..1", label="", labelfontsize=11];
  "devices" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>Device</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "fog_collectors" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>FogCollector</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "tanks" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>Tank</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>User</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
}