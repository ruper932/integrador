digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.7, splines=true, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12, color="#2B4D3B"];
  edge [color="#55675C", fontname="DejaVu Sans", fontsize=11, fontcolor="#2B4D3B", arrowsize=0.8];
  graph [nodesep=0.2, ranksep=0.55];
  "maintenance_records" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>MaintenanceRecord</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ status: str<br/>+ incident_report_id: int [0..1] {FK}<br/>+ device_id: int [0..1] {FK}<br/>+ sensor_id: int [0..1] {FK}<br/>+ performed_at: datetime [0..1]<br/>+ user_id: int {FK}<br/>+ maintenance_type: str [0..1]<br/>+ description: str [0..1]<br/>+ final_status: str [0..1]<br/>+ accepted_at: datetime [0..1]<br/>+ started_at: datetime [0..1]<br/>+ finished_at: datetime [0..1]<br/>+ created_at: datetime</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "maintenance_items" [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#2B4D3B" bgcolor="white"><tr><td bgcolor="#B9D2C2"><b>MaintenanceItem</b></td></tr><tr><td align="left" balign="left">+ id: int {PK}<br/>+ maintenance_record_id: int {FK}<br/>+ item_id: int {FK}<br/>+ quantity: decimal<br/>+ movement_id: int {FK}</td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  "maintenance_records" -> "incident_reports" [arrowhead=none, taillabel="0..1", headlabel="0..1", label="", labelfontsize=11];
  "maintenance_records" -> "devices" [arrowhead=none, taillabel="*", headlabel="0..1", label="", labelfontsize=11];
  "maintenance_records" -> "sensors" [arrowhead=none, taillabel="*", headlabel="0..1", label="", labelfontsize=11];
  "maintenance_records" -> "users" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "maintenance_items" -> "maintenance_records" [arrowhead=none, taillabel="*", headlabel="1", label="", labelfontsize=11];
  "maintenance_items" -> "inventory_items" [arrowhead=none, taillabel="*", headlabel="1", label="item", labelfontsize=11];
  "maintenance_items" -> "inventory_movements" [arrowhead=none, taillabel="0..1", headlabel="1", label="movement", labelfontsize=11];
  "devices" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>Device</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "incident_reports" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>IncidentReport</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "inventory_items" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>InventoryItem</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "inventory_movements" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>InventoryMovement</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "sensors" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>Sensor</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
  "users" [label=<<table border="1" cellborder="0" cellpadding="4" color="#2B4D3B" bgcolor="#FBF7F1"><tr><td><b>User</b><br/><font point-size="8" color="#55675C">(otro módulo)</font></td></tr></table>>];
}