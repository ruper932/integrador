<mxfile host="Electron"><diagram id="nav" name="Mapa navegacional"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="1260" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Cada pantalla indica su ruta y los roles que la ven en el menú: &lt;b&gt;A&lt;/b&gt; administrador · &lt;b&gt;Dir&lt;/b&gt; director · &lt;b&gt;Doc&lt;/b&gt; docente · &lt;b&gt;M&lt;/b&gt; mantenimiento. El backend vuelve a verificar cada permiso." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#1d2939;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="44" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Inicio de sesión&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;/login&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dbe7fb;strokeColor=#3b5bdb;fontSize=12;fontFamily=Arial;fontColor=#1d2939;fontSize=15;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="240" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Recuperación de cuenta&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;/recuperar-cuenta&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fdecea;strokeColor=#b42318;fontSize=12;fontFamily=Arial;fontColor=#1d2939;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="230" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Cambiar contraseña temporal&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;/cambiar-contrasena&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fdecea;strokeColor=#b42318;fontSize=12;fontFamily=Arial;fontColor=#1d2939;fontSize=15;" vertex="1" parent="1"><mxGeometry x="650" y="90" width="290" height="60" as="geometry"/></mxCell><mxCell id="c5" value="olvidó su contraseña" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFi